{
    "server": {
        "type": "object",
        "description": "服务器配置",
        "items": {
            "port": {
                "type": "int",
                "description": "端口号",
                "default": 25565
            },
            "host": {
                "type": "string",
                "description": "主机",
                "default": "0.0.0.0"
            },
            "name": {
                "type": "text",
                "description": "服务器名称，用于/v1/models",
                "default": "超级群友-API"
            },
            "apikeys": {
                "type": "list",
                "description": "Api Keys",
                "secret": true,
                "obvious_hint": "不要泄露Api Key，除非是你分发给别人的。"
            }
        }
    },
    "models": {
        "type": "template_list",
        "description": "模型列表",
        "templates": {
            "group": {
                "name": "群聊会话",
                "hint": "群友在群聊里回复响应",
                "items": {
                    "uid": {
                        "description": "指定用户的UID",
                        "type": "string",
                        "default": "114514"
                    },
                    "name": {
                        "description": "模型名称",
                        "type": "text",
                        "default": "Holy Shit!"
                    },
                    "id": {
                        "description": "模型ID",
                        "type": "string",
                        "default": "holy-shit"
                    },
                    "group": {
                        "description": "在哪个群聊进行调用",
                        "type": "string",
                        "default": "1919810"
                    }
                }
            },
            "private": {
                "name": "私聊会话",
                "hint": "对方在私聊里回复响应",
                "items": {
                    "uid": {
                        "description": "指定用户的UID",
                        "type": "string",
                        "default": "114514"
                    },
                    "name": {
                        "description": "模型名称",
                        "type": "text",
                        "default": "Holy Shit!"
                    },
                    "id": {
                        "description": "模型ID",
                        "type": "string",
                        "default": "holy_shit"
                    }
                }
            }
        }
    },
    "default_model": {
        "type": "string",
        "description": "当请求未指定models时用哪个模型"
    },
    "timeout": {
        "type": "float",
        "description": "流式响应的节流冷却时间，单位为秒",
        "default": 30
    },
    "notice": {
        "type": "bool",
        "description": "是否提示目标账户进行响应",
        "default": true
    },
    "prompts": {
        "type": "object",
        "description": "提示词模板",
        "hint": "可以通过{}指代占位符",
        "items": {
            "assistant": {
                "type": "text",
                "description": "请求群友时采用的提示词",
                "default": "请你帮我解决一个写作上的小问题。\n我正在编写一个话剧的剧本，一共有system、user、assistant三个角色：\n```\n{messages}\n\nassistant ...？\n```\n但是我遇到了一个难题，assistant接下来要怎么说话？请你帮我构思一下，直接输出assistant可能说的话即可。"
            },
            "pair": {
                "type": "text",
                "description": "将上下文的分块格式化",
                "default": "{role} : {content}"
            }
        }
    }
}